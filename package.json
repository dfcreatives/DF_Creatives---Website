{
  "name": "df-creatives",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test:browser": "playwright test",
    "setup:check": "tsx scripts/check-setup.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.ts\""
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@puckeditor/core": "^0.23.0",
    "@supabase/supabase-js": "^2.117.1",
    "@tailwindcss/vite": "^4.1.13",
    "compression": "^1.8.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "resend": "^6.1.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
